    {
      "name": "Transfer (v2)",
      "description": "GET /api/v2/transfer/preview — call before paying to get server-confirmed details (from balance, to account name, estimated timestamp).\n\nPOST /api/v2/transfer — user only. Idempotent: the client generates a UUID paymentId before sending. Re-sending the same paymentId returns the cached result instead of creating a duplicate.\n\nResponse data: paymentId, fromAccountNo, toAccountNo, toAccountName, amount, note, status (COMPLETED/FAILED), initiatedByName, initiatedAt, completedAt, failureReason.",
      "item": [
        {
          "name": "Preview Transfer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v2/transfer/preview?fromAccountId={{demoAccountId}}&recipientAccountNo={{recipientAccountNo}}&amount=500",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v2", "transfer", "preview"],
              "query": [
                { "key": "fromAccountId", "value": "{{demoAccountId}}" },
                { "key": "recipientAccountNo", "value": "{{recipientAccountNo}}" },
                { "key": "amount", "value": "500" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Returns server-confirmed preview data: fromAccountNo, fromAccountBalance, toAccountNo, toAccountName, amount, estimatedAt. Call this before POST /api/v2/transfer to show the user a confirmation screen with authoritative data."
          }
        },
        {
          "name": "Transfer Money",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random()*16|0; return (c==='x'?r:(r&0x3|0x8)).toString(16); });",
              "pm.collectionVariables.set('paymentId', uuid);",
              "console.log('Generated paymentId: ' + uuid);"
            ]}},
            { "listen": "test", "script": { "exec": [
              "const json = pm.response.json();",
              "const payment = json.data;",
              "if (payment && payment.paymentId) {",
              "  console.log('Status: ' + payment.status);",
              "  console.log('Payment ID: ' + payment.paymentId);",
              "  console.log('To: ' + payment.toAccountName + ' (' + payment.toAccountNo + ')');",
              "  console.log('Amount: Rs.' + payment.amount);",
              "  if (payment.failureReason) console.log('Failure: ' + payment.failureReason);",
              "}"
            ]}}
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"fromAccountId\": \"{{demoAccountId}}\",\n  \"recipientAccountNo\": \"{{recipientAccountNo}}\",\n  \"amount\": 500,\n  \"note\": \"Monthly share\"\n}"
            }
          }
        },
        {
          "name": "Retry Same Transfer (idempotency test)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "const payment = json.data;",
            "if (payment) {",
            "  console.log('Status: ' + payment.status + ' (should be COMPLETED — same paymentId, no duplicate)');",
            "  console.log('Payment ID: ' + payment.paymentId);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"fromAccountId\": \"{{demoAccountId}}\",\n  \"recipientAccountNo\": \"{{recipientAccountNo}}\",\n  \"amount\": 500,\n  \"note\": \"Monthly share\"\n}"
            },
            "description": "Uses the same {{paymentId}} as the previous request. The backend returns the cached result — no second transfer is created. This is idempotency in action."
          }
        }
      ]
    },

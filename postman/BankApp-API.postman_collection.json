    {
      "name": "Accounts",
      "description": "GET /api/v1/accounts returns all accounts (admin/BankManager) or only the caller's own accounts (user). GET /api/v1/accounts/lookup finds by account number.",
      "item": [
        {
          "name": "Lookup Account by Number",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/lookup?accountNo=SB002001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "lookup"],
              "query": [{ "key": "accountNo", "value": "SB002001" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]

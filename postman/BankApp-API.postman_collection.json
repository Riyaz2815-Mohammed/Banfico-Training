            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "Ri8e2MP0dp1dH3VwZ0EdO4GS2RRkaAmsqYqkTgaGZz5dF5zPOaUka7KSiSO9e7yyy28oX0LspdJO4bXov4YqbL" },
              { "key": "username", "value": "priya" },
              { "key": "password", "value": "Priya@1234" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Get Token (arjun — user)",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('token', json.access_token);", "console.log('Token set — role: user (arjun)');"] } }],
          "request": {

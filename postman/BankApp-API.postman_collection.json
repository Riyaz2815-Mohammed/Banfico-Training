{
  "info": {
    "name": "BankApp API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8180" },
    { "key": "realm", "value": "bankapp" },
    { "key": "token", "value": "" },
    { "key": "riyazCustomerId", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567891" },
    { "key": "riyazSavingsAccountId", "value": "b1b2c3d4-e5f6-7890-abcd-ef1234567801" },
    { "key": "riyazCurrentAccountId", "value": "b1b2c3d4-e5f6-7890-abcd-ef1234567802" },
    { "key": "demoAccountId", "value": "" },
    { "key": "demoAccountNo", "value": "" },
    { "key": "recipientAccountId", "value": "" },
    { "key": "recipientAccountNo", "value": "" },
    { "key": "demoBeneficiaryId", "value": "" },
    { "key": "clientSecret", "value": "FILL_IN", "description": "Keycloak client secret for bankapp-frontend" },
    { "key": "riyazPassword", "value": "FILL_IN" },
    { "key": "priyaPassword", "value": "FILL_IN" },
    { "key": "arjunPassword", "value": "FILL_IN" },
    { "key": "snehaPassword", "value": "FILL_IN" },
    { "key": "rahulPassword", "value": "FILL_IN" },
    { "key": "managerPassword", "value": "FILL_IN", "description": "Password for the manager user (BankManager role)" },
    { "key": "registeredCustomerId", "value": "" },
    { "key": "registeredKeycloakUserId", "value": "" }
  ],
  "item": [
    {
      "name": "User Workflow (Demo)",
      "description": "Run these requests top to bottom to demo the full user journey. Test scripts auto-capture IDs between steps — no manual copy-paste needed.\n\nSteps:\n1. Login as Priya\n2. See only Priya's accounts\n3. View transactions for her account\n4. Lookup a recipient by account number\n5. Add them as a beneficiary\n6. View saved beneficiaries\n7. Transfer money\n8. Confirm transfer appears in transactions",
      "item": [
        {
          "name": "Step 1 — Login as Priya (user)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.access_token);",
            "console.log('Logged in as priya (user role)');"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "{{clientSecret}}" },
              { "key": "username", "value": "priya" },
              { "key": "password", "value": "{{priyaPassword}}" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Step 2 — View My Accounts",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.length > 0) {",
            "  pm.collectionVariables.set('demoAccountId', json[0].id);",
            "  pm.collectionVariables.set('demoAccountNo', json[0].accountNo);",
            "  console.log('Saved account: ' + json[0].accountNo + ' (' + json[0].accountType + ') — balance ₹' + json[0].balance);",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/accounts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Returns only Priya's accounts. Notice: no other customers' accounts are visible."
          }
        },
        {
          "name": "Step 3 — View My Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{demoAccountId}}/transactions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Shows transactions for Priya's first account. Each row has description (Cash Deposit / Cash Withdrawal / Transfer from Name) and a balance snapshot at time of transaction. Sorted newest first."
          }
        },
        {
          "name": "Step 4 — Lookup Recipient by Account Number",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.id) {",
            "  pm.collectionVariables.set('recipientAccountId', json.id);",
            "  pm.collectionVariables.set('recipientAccountNo', json.accountNo);",
            "  console.log('Recipient: ' + json.accountHolderName + ' — ' + json.accountType + ' ' + json.accountNo);",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/accounts/lookup?accountNo=SB001001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "lookup"],
              "query": [{ "key": "accountNo", "value": "SB001001" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Finds an account by its account number and returns the holder's name. Used to confirm you are sending to the right person before adding or transferring. Change accountNo to any other user's account."
          }
        },
        {
          "name": "Step 5 — Add as Beneficiary",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.id) {",
            "  pm.collectionVariables.set('demoBeneficiaryId', json.id);",
            "  console.log('Beneficiary saved: ' + json.accountHolderName + ' (' + json.nickname + ')');",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/me/beneficiaries",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{recipientAccountId}}\",\n  \"nickname\": \"Riyaz\"\n}"
            },
            "description": "Saves the looked-up account as a beneficiary with a nickname. recipientAccountId was auto-captured in Step 4."
          }
        },
        {
          "name": "Step 6 — View My Beneficiaries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/beneficiaries",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Confirms the beneficiary was added. Shows accountHolderName, accountNo and accountType."
          }
        },
        {
          "name": "Step 7 — Transfer Money",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.referenceId) {",
            "  console.log('Transfer successful!');",
            "  console.log('Reference: ' + json.referenceId.slice(0,8).toUpperCase());",
            "  console.log('Remaining balance: ₹' + json.remainingBalance);",
            "  console.log('Recipient: ' + json.recipientName + ' (' + json.recipientAccountNo + ')');",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/me/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{demoAccountId}}\",\n  \"recipientAccountNo\": \"{{recipientAccountNo}}\",\n  \"amount\": 1000\n}"
            },
            "description": "Transfers ₹1000 from Priya's first account to the recipient found in Step 4. fromAccountId and recipientAccountNo are auto-filled from previous steps."
          }
        },
        {
          "name": "Step 8 — Confirm Transfer in Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{demoAccountId}}/transactions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "The latest transaction (top of the list) should show type DEBIT, description 'Transfer to Riyaz Ahmed', amount ₹1000, and the updated balance snapshot."
          }
        },
        {
          "name": "Step 9 — Remove Beneficiary (cleanup)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/me/beneficiaries/{{demoBeneficiaryId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Optional cleanup — removes the beneficiary added in Step 5. demoBeneficiaryId was auto-captured."
          }
        }
      ]
    },
    {
      "name": "BankManager Workflow (Demo)",
      "description": "Run top to bottom to demo the full BankManager onboarding flow.\n\nSteps:\n1. Login as manager (BankManager role)\n2. Register a new user — creates both Keycloak account and customer DB record\n3. Login as admin to create an account for the new customer\n4. Create account for the registered customer\n5. Share credentials with the user — they log in and change their password\n\nNote: after Step 2, check the console log for the customerId and keycloakUserId.",
      "item": [
        {
          "name": "Step 1 — Login as Manager",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.access_token);",
            "console.log('Logged in as manager (BankManager role)');"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "{{clientSecret}}" },
              { "key": "username", "value": "manager" },
              { "key": "password", "value": "{{managerPassword}}" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Step 2 — Register New User",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.customerId) {",
            "  pm.collectionVariables.set('registeredCustomerId', json.customerId);",
            "  pm.collectionVariables.set('registeredKeycloakUserId', json.keycloakUserId);",
            "  console.log('Registered: ' + json.firstName + ' ' + json.lastName + ' (' + json.email + ')');",
            "  console.log('customerId: ' + json.customerId);",
            "  console.log('keycloakUserId: ' + json.keycloakUserId);",
            "  console.log(json.message);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/register",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@bankapp.com\",\n  \"pan\": \"ABCDE1234F\",\n  \"phoneNumber\": \"9876543210\",\n  \"username\": \"johndoe\",\n  \"temporaryPassword\": \"TempPass@1\"\n}"
            },
            "description": "Creates a Keycloak user account (with user role and temporary password) AND a customer DB record in one call. Returns customerId, keycloakUserId and a confirmation message.\n\nRoles that can call this: admin, BankManager.\n\nThe new user can log in immediately with the username/password above. On first login Keycloak will prompt them to set a new password (because temporaryPassword: true)."
          }
        },
        {
          "name": "Step 3 — Login as Admin (to create account)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.access_token);",
            "console.log('Switched to admin token — ready to create account');"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "{{clientSecret}}" },
              { "key": "username", "value": "riyaz" },
              { "key": "password", "value": "{{riyazPassword}}" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Step 4 — Create Account for Registered Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/accounts",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNo\": \"SB010001\",\n  \"accountType\": \"SAVINGS\",\n  \"balance\": 10000,\n  \"customerId\": \"{{registeredCustomerId}}\"\n}"
            },
            "description": "Creates a savings account for the newly registered customer. registeredCustomerId was auto-captured in Step 2. After this step the user can see their account when they log in."
          }
        }
      ]
    },
    {

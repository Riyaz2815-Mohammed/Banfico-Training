{
  "info": {
    "name": "BankApp API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8180" },
    { "key": "realm", "value": "bankapp" },
    { "key": "token", "value": "" },
    { "key": "riyazCustomerId", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567891" },
    { "key": "riyazSavingsAccountId", "value": "b1b2c3d4-e5f6-7890-abcd-ef1234567801" },
    { "key": "riyazCurrentAccountId", "value": "b1b2c3d4-e5f6-7890-abcd-ef1234567802" },
    { "key": "demoAccountId", "value": "" },
    { "key": "demoAccountNo", "value": "" },
    { "key": "recipientAccountId", "value": "" },
    { "key": "recipientAccountNo", "value": "" },
    { "key": "demoBeneficiaryId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "clientSecret", "value": "FILL_IN", "description": "Keycloak client secret for bankapp-frontend" },
    { "key": "riyazPassword", "value": "FILL_IN" },
    { "key": "priyaPassword", "value": "FILL_IN" },
    { "key": "arjunPassword", "value": "FILL_IN" },
    { "key": "snehaPassword", "value": "FILL_IN" },
    { "key": "rahulPassword", "value": "FILL_IN" },
    { "key": "managerPassword", "value": "FILL_IN", "description": "Password for the manager user (BankManager role)" },
    { "key": "registeredCustomerId", "value": "" },
    { "key": "registeredKeycloakUserId", "value": "" }
  ],
  "item": [
    {
      "name": "User Workflow (Demo)",
      "description": "Run these requests top to bottom to demo the full user journey. Test scripts auto-capture IDs between steps — no manual copy-paste needed.\n\nSteps:\n1. Login as Priya\n2. See only Priya's accounts (RBAC — same endpoint as admin but filtered by JWT)\n3. View transactions for her account\n4. Lookup a recipient by account number\n5. Add them as a beneficiary\n6. View saved beneficiaries\n7. Transfer money (v2 — idempotent, generates a paymentId automatically)\n8. Confirm transfer appears in transactions\n9. Remove beneficiary (cleanup)",
      "item": [
        {
          "name": "Step 1 — Login as Priya (user)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.access_token);",
            "console.log('Logged in as priya (user role)');"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "{{clientSecret}}" },
              { "key": "username", "value": "priya" },
              { "key": "password", "value": "{{priyaPassword}}" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Step 2 — View My Accounts",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.length > 0) {",
            "  pm.collectionVariables.set('demoAccountId', json[0].id);",
            "  pm.collectionVariables.set('demoAccountNo', json[0].accountNo);",
            "  console.log('Saved account: ' + json[0].accountNo + ' (' + json[0].accountType + ') — balance Rs.' + json[0].balance);",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/accounts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Returns only Priya's accounts because she has the user role. An admin or BankManager hitting the same endpoint would see all accounts."
          }
        },
        {
          "name": "Step 3 — View My Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?accountId={{demoAccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [{ "key": "accountId", "value": "{{demoAccountId}}" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Step 4 — Lookup Recipient by Account Number",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.id) {",
            "  pm.collectionVariables.set('recipientAccountId', json.id);",
            "  pm.collectionVariables.set('recipientAccountNo', json.accountNo);",
            "  console.log('Recipient: ' + json.accountHolderName + ' — ' + json.accountType + ' ' + json.accountNo);",
            "}"
          ]}}],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/lookup?accountNo=SB001001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "lookup"],
              "query": [{ "key": "accountNo", "value": "SB001001" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Step 5 — Add as Beneficiary",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.id) {",
            "  pm.collectionVariables.set('demoBeneficiaryId', json.id);",
            "  console.log('Beneficiary saved: ' + json.accountHolderName + ' (' + json.nickname + ')');",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/beneficiaries",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{recipientAccountId}}\",\n  \"nickname\": \"Riyaz\"\n}"
            }
          }
        },
        {
          "name": "Step 6 — View My Beneficiaries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/beneficiaries",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Step 7 — Transfer Money",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random()*16|0; return (c==='x'?r:(r&0x3|0x8)).toString(16); });",
              "pm.collectionVariables.set('paymentId', uuid);",
              "console.log('Generated paymentId: ' + uuid);"
            ]}},
            { "listen": "test", "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.paymentId) {",
              "  console.log('Transfer status: ' + json.status);",
              "  console.log('Payment ID: ' + json.paymentId);",
              "  console.log('To: ' + json.toAccountName + ' (' + json.toAccountNo + ')');",
              "  console.log('Amount: Rs.' + json.amount);",
              "}"
            ]}}
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"fromAccountId\": \"{{demoAccountId}}\",\n  \"recipientAccountNo\": \"{{recipientAccountNo}}\",\n  \"amount\": 1000,\n  \"note\": \"Test transfer\"\n}"
            },
            "description": "Idempotent transfer — a UUID paymentId is auto-generated by the pre-request script. Re-sending this request with the same paymentId returns the cached result instead of creating a duplicate transfer.\n\nResponse is a PaymentResponse: paymentId, fromAccountNo, toAccountNo, toAccountName, amount, status (COMPLETED/FAILED), initiatedAt."
          }
        },
        {
          "name": "Step 8 — Confirm Transfer in Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?accountId={{demoAccountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [{ "key": "accountId", "value": "{{demoAccountId}}" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Step 9 — Remove Beneficiary (cleanup)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/beneficiaries/{{demoBeneficiaryId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "BankManager Workflow (Demo)",
      "description": "Run top to bottom to demo the full BankManager onboarding flow.\n\nSteps:\n1. Login as manager (BankManager role)\n2. Register a new user — creates both Keycloak account and customer DB record\n3. Login as admin to create an account for the new customer\n4. Create account for the registered customer",
      "item": [
        {
          "name": "Step 1 — Login as Manager",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.access_token);",
            "console.log('Logged in as manager (BankManager role)');"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "{{clientSecret}}" },
              { "key": "username", "value": "manager" },
              { "key": "password", "value": "{{managerPassword}}" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Step 2 — Register New User",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.customerId) {",
            "  pm.collectionVariables.set('registeredCustomerId', json.customerId);",
            "  pm.collectionVariables.set('registeredKeycloakUserId', json.keycloakUserId);",
            "  console.log('Registered: ' + json.firstName + ' ' + json.lastName + ' (' + json.email + ')');",
            "  console.log('customerId: ' + json.customerId);",
            "  console.log(json.message);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/register",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@bankapp.com\",\n  \"pan\": \"ABCDE1234F\",\n  \"phoneNumber\": \"9876543210\",\n  \"username\": \"johndoe\",\n  \"temporaryPassword\": \"TempPass@1\"\n}"
            }
          }
        },
        {
          "name": "Step 3 — Login as Admin (to create account)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('token', json.access_token);",
            "console.log('Switched to admin token — ready to create account');"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "{{clientSecret}}" },
              { "key": "username", "value": "riyaz" },
              { "key": "password", "value": "{{riyazPassword}}" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {
          "name": "Step 4 — Create Account for Registered Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/accounts",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNo\": \"SB010001\",\n  \"accountType\": \"SAVINGS\",\n  \"balance\": 10000,\n  \"customerId\": \"{{registeredCustomerId}}\"\n}"
            }
          }
        }
      ]
    },

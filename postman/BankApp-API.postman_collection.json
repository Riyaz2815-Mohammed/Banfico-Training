    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        },
        {
          "name": "App Info",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/info" }
        }
      ]
    },
    {
      "name": "Me (Current User)",
      "description": "All /api/me/* endpoints are scoped to the authenticated user via JWT email — no customer ID needed in the URL.",
      "item": [
        {
          "name": "Get My Accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/accounts",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Returns only the accounts belonging to the logged-in user."
          }
        },
        {
          "name": "Get My Beneficiaries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/me/beneficiaries",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Returns saved beneficiaries for the logged-in user. Each entry includes accountHolderName, accountNo and accountType."
          }
        },
        {
          "name": "Add Beneficiary",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/me/beneficiaries",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"<UUID of recipient account — get from /api/accounts/lookup>\",\n  \"nickname\": \"Priya\"\n}"
            },
            "description": "Add a beneficiary. Use GET /api/accounts/lookup?accountNo= first to resolve the account UUID."
          }
        },
        {
          "name": "Remove Beneficiary",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/me/beneficiaries/:beneficiaryId",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "description": "Only removes a beneficiary that belongs to the logged-in user. Returns 403 if the beneficiary belongs to someone else."
          }
        },
        {
          "name": "Transfer Money",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/me/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{riyazSavingsAccountId}}\",\n  \"recipientAccountNo\": \"SB002001\",\n  \"amount\": 5000\n}"
            },
            "description": "Transfers money between two accounts atomically. Debits fromAccountId and credits recipientAccountNo. Both accounts get a transaction record — sender sees 'Transfer to Name', recipient sees 'Transfer from Name'. Returns referenceId, remainingBalance and timestamp.\n\nErrors:\n- 403 if fromAccountId does not belong to the logged-in user\n- 400 if sender tries to transfer to their own account\n- 500 if balance is insufficient (InsufficientBalanceException)"
          }
        }
      ]
    },
    {
      "name": "Customers (Admin + BankManager)",
      "description": "View and register customers — accessible by admin and BankManager roles.\n\nPOST /api/register: creates Keycloak user + customer DB record (admin + BankManager).\nPOST/PUT/GET /api/customers: admin only (except view).\nDELETE /api/customers: admin only.",
      "item": [
        {
          "name": "Register User (admin + BankManager)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.customerId) {",
            "  pm.collectionVariables.set('registeredCustomerId', json.customerId);",
            "  console.log('Registered: ' + json.firstName + ' ' + json.lastName);",
            "  console.log('customerId: ' + json.customerId);",
            "  console.log(json.message);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/register",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@bankapp.com\",\n  \"pan\": \"ABCDE1234F\",\n  \"phoneNumber\": \"9876543210\",\n  \"username\": \"johndoe\",\n  \"temporaryPassword\": \"TempPass@1\"\n}"
            },
            "description": "Creates a Keycloak user with the 'user' role and a temporary password, AND saves the customer record to the database. The user can log in immediately — Keycloak will prompt for a password change on first login.\n\nRequired roles: admin or BankManager."
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Customer (Riyaz)",

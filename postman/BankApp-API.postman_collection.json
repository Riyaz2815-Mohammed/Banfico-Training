    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
        },
        {
          "name": "App Info",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/info" }
        }
      ]
    },
    {
      "name": "Customers (Admin + BankManager)",
      "description": "View and register customers — accessible by admin and BankManager roles.\n\nPOST /api/v1/register: creates Keycloak user + customer DB record (admin + BankManager).\nPOST/PUT/GET /api/v1/customers: admin only (except view).\nDELETE /api/v1/customers: admin only.",
      "item": [
        {
          "name": "Register User (admin + BankManager)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.customerId) {",
            "  pm.collectionVariables.set('registeredCustomerId', json.customerId);",
            "  console.log('Registered: ' + json.firstName + ' ' + json.lastName);",
            "  console.log('customerId: ' + json.customerId);",
            "  console.log(json.message);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/register",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@bankapp.com\",\n  \"pan\": \"ABCDE1234F\",\n  \"phoneNumber\": \"9876543210\",\n  \"username\": \"johndoe\",\n  \"temporaryPassword\": \"TempPass@1\"\n}"
            },
            "description": "Creates a Keycloak user with the 'user' role and a temporary password, AND saves the customer record to the database. The user can log in immediately — Keycloak will prompt for a password change on first login.\n\nRequired roles: admin or BankManager."
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/customers",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Customer (Riyaz)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/customers/{{riyazCustomerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/customers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"XYZAB1234Z\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"email\": \"test@bankapp.com\",\n  \"phoneNumber\": \"9999999999\"\n}"
            }
          }
        },
        {
          "name": "Update Customer (Riyaz)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/customers/{{riyazCustomerId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"ABCPR1234R\",\n  \"firstName\": \"Riyaz\",\n  \"lastName\": \"Ahmed\",\n  \"email\": \"riyaz@bankapp.com\",\n  \"phoneNumber\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Delete Customer (ADMIN only — 403 for user role)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/customers/{{riyazCustomerId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "description": "GET /api/v1/accounts returns all accounts (admin/BankManager) or only the caller's own accounts (user). GET /api/v1/accounts/lookup finds by account number — used before adding a beneficiary or initiating a transfer.",
      "item": [
        {
          "name": "Lookup Account by Number",
          "request": {
            "method": "GET",
            "url": {

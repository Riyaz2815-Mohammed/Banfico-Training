    {
      "name": "Customers (Admin + BankManager)",
      "description": "View and register customers — accessible by admin and BankManager roles.\n\nPOST /api/v1/register — creates Keycloak user + customer DB record (admin + BankManager).\nPOST /api/v1/managers — creates a BankManager account in Keycloak (admin only).\nGET/PUT/DELETE /api/v1/customers — admin only.",
      "item": [
        {
          "name": "Register User (admin + BankManager)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.customerId) {",
            "  pm.collectionVariables.set('registeredCustomerId', json.customerId);",
            "  console.log('Registered: ' + json.firstName + ' ' + json.lastName);",
            "  console.log('customerId: ' + json.customerId);",
            "  console.log(json.message);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/register",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@bankapp.com\",\n  \"pan\": \"ABCDE1234F\",\n  \"phoneNumber\": \"9876543210\",\n  \"username\": \"johndoe\",\n  \"temporaryPassword\": \"TempPass@1\"\n}"
            }
          }
        },
        {
          "name": "Create Manager (admin only)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.keycloakId) {",
            "  console.log('Manager created: ' + json.firstName + ' ' + json.lastName + ' (' + json.email + ')');",
            "  console.log('keycloakId: ' + json.keycloakId);",
            "  console.log(json.message);",
            "}"
          ]}}],

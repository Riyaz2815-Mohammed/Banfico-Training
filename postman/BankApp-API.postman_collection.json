{
  "info": {
    "name": "BankApp API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8180" },
    { "key": "realm", "value": "bankapp" },
    { "key": "token", "value": "" },
    { "key": "riyazCustomerId", "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567891" },
    { "key": "riyazSavingsAccountId", "value": "b1b2c3d4-e5f6-7890-abcd-ef1234567801" },
    { "key": "riyazCurrentAccountId", "value": "b1b2c3d4-e5f6-7890-abcd-ef1234567802" }
  ],
  "item": [
    {
      "name": "🔑 Auth",
      "description": "Get access tokens. Run one of these first — the test script auto-sets the {{token}} variable. Admin (riyaz) can access all endpoints. Regular users are scoped to their own data via /api/me/*.",
      "item": [
        {
          "name": "Get Token (riyaz — admin)",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('token', json.access_token);", "console.log('Token set — role: admin (riyaz)');"] } }],
          "request": {
            "method": "POST",
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "password" },
              { "key": "client_id", "value": "bankapp-frontend" },
              { "key": "client_secret", "value": "Ri8e2MP0dp1dH3VwZ0EdO4GS2RRkaAmsqYqkTgaGZz5dF5zPOaUka7KSiSO9e7yyy28oX0LspdJO4bXov4YqbL" },
              { "key": "username", "value": "riyaz" },
              { "key": "password", "value": "Riyaz@1234" },
              { "key": "scope", "value": "openid" }
            ]}
          }
        },
        {

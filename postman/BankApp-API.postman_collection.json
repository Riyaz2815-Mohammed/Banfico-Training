    {
      "name": "Transfer (v2)",
      "description": "POST /api/v2/transfer — user only. Idempotent: the client generates a UUID paymentId before sending. Re-sending the same paymentId returns the cached result instead of creating a duplicate.\n\nResponse is PaymentResponse: paymentId, fromAccountNo, toAccountNo, toAccountName, amount, note, status (COMPLETED/FAILED), initiatedByName, initiatedAt, completedAt, failureReason.",
      "item": [
        {
          "name": "Transfer Money",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random()*16|0; return (c==='x'?r:(r&0x3|0x8)).toString(16); });",
              "pm.collectionVariables.set('paymentId', uuid);",
              "console.log('Generated paymentId: ' + uuid);"
            ]}},
            { "listen": "test", "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.paymentId) {",
              "  console.log('Status: ' + json.status);",
              "  console.log('Payment ID: ' + json.paymentId);",
              "  console.log('To: ' + json.toAccountName + ' (' + json.toAccountNo + ')');",
              "  console.log('Amount: Rs.' + json.amount);",
              "  if (json.failureReason) console.log('Failure: ' + json.failureReason);",
              "}"
            ]}}
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"fromAccountId\": \"{{demoAccountId}}\",\n  \"recipientAccountNo\": \"SB002001\",\n  \"amount\": 500,\n  \"note\": \"Monthly share\"\n}"
            }
          }
        },
        {
          "name": "Retry Same Transfer (idempotency test)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "console.log('Status: ' + json.status + ' (should be COMPLETED — same paymentId, no duplicate)');",
            "console.log('Payment ID: ' + json.paymentId);"
          ]}}],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v2/transfer",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"fromAccountId\": \"{{demoAccountId}}\",\n  \"recipientAccountNo\": \"SB002001\",\n  \"amount\": 500,\n  \"note\": \"Monthly share\"\n}"
            },
            "description": "Uses the same {{paymentId}} as the previous request. The backend returns the cached result — no second transfer is created. This is idempotency in action."
          }
        }
      ]
    },
